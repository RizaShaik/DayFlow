# Server
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Database (must match docker-compose.yml if using Docker)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=dayflow
DB_USER=dayflow
DB_PASSWORD=dayflow

# Auth
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# SMTP (email verification + temp password delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Dayflow HRMS <no-reply@dayflow.local>"

# Uploads
MAX_UPLOAD_MB=5
